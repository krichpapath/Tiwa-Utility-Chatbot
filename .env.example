DISCORD_TOKEN=
OPENROUTER_API_KEY=
TIWA_MODE=api
TIWA_HOME_CHANNEL=
# Optional override. Calendar approvals otherwise require Discord application owner.
TIWA_OWNER_ID=
TIWA_VOICE=dj
TIWA_LISTEN=0
TIWA_STT_MODEL=openai/gpt-transcribe
TIWA_WAKE_MODEL=
TIWA_WAKE_THRESHOLD=0.9
TIWA_SILENCE_S=1.2
TIWA_RECORD_MAX_S=20
TIWA_VOICE_REPLY=0
TIWA_DAILY_TOKENS=2000000
TIWA_LOG_PROMPTS=1

# Google Calendar ID from calendar settings; primary if unset.
TIWA_CALENDAR_ID=primary
